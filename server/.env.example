# --- Required ---
# Local Docker:  postgresql://pantry:pantry@localhost:5432/smart_pantry
# Neon (cloud):  postgresql://USER:PASSWORD@HOST.neon.tech/smart_pantry?sslmode=require
DATABASE_URL=postgresql://pantry:pantry@localhost:5432/smart_pantry

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000
NODE_ENV=development

# Local development only: when email isn't set up, show password-reset links on screen.
# Never set this on a deployed server (it is ignored when NODE_ENV=production).
DEV_SHOW_RESET_LINK=true

# Where the React app runs (used for CORS and password-reset links)
CLIENT_URL=http://localhost:5173

# --- Optional: email reminders & password-reset emails ---
# Leave SMTP_HOST empty to disable email. The app still works fully; nothing is reported as "sent".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Pantry <no-reply@example.com>"

# --- Optional: barcode lookup (Open Food Facts, free, no key needed) ---
BARCODE_LOOKUP_ENABLED=true

# --- Optional: online recipes with cooking videos (TheMealDB, free, no key needed) ---
ONLINE_RECIPES_ENABLED=true

# Daily reminder job time (cron syntax, server time). Default 08:00.
REMINDER_CRON=0 8 * * *

# Phone notifications (Web Push). Optional: leave empty and the server makes a key pair once and keeps it in the database.
# To use your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
